# Existing database connection
DATABASE_URL=

# Exact trusted frontend origins, comma-separated. Required for auth and writes.
# Production: set this to your actual HTTPS site origin, without a trailing slash.
AUTH_APP_ORIGINS=http://localhost:3000

# Optional dedicated, disposable database used ONLY for auth integration tests.
# Never point this at a production database.
AUTH_TEST_DATABASE_URL=

# Dedicated disposable Neon database for appointment integration tests (Node 22+).
# Never use the production DATABASE_URL here.
APPOINTMENT_TEST_DATABASE_URL=postgresql://neondb_owner:npg_7cyghGv8OMUd@ep-steep-queen-azc64j2m.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# AI generation is deliberately off by default.
AI_FEATURE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REQUEST_TIMEOUT_MS=20000

# Anonymous student feedback also requires AI_FEATURE_ENABLED and AUTH_APP_ORIGINS.
STUDENT_AI_FEATURE_ENABLED=false
