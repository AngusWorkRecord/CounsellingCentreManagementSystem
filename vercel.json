{
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "devCommand": "npm run start",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api(?:/.*)?", "status": 404 },
    { "src": "/(static/.*|.*\\.[^/]+|ws|sockjs-node(?:/.*)?)", "dest": "/$1" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
